{
  "name": "dsh-jev-interceptor",
  "version": "0.2.4",
  "description": "Millisecond System-1 judgement for every tool call in DeepSeek Harness: Jev-powered risk classification and evidence-gated auto-approval, fail-closed by construction.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./session-reference": {
      "types": "./lib/session-reference.d.ts",
      "default": "./lib/session-reference.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"fs.rmSync('lib', {force: true, recursive: true})\" --input-type=module 2>/dev/null || rimraf lib",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "jev",
    "typesafe",
    "system-one",
    "system-1",
    "agent-harness",
    "tool-approval"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-compaction": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-launch-environment": "*",
    "@deepseek-ai/dsh-output-retention": "*",
    "@deepseek-ai/dsh-session-query": "*",
    "@deepseek-ai/dsh-session-reference": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-commands": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-compaction": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-output-retention": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-permission-presets": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-session-query": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-session-reference": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-user-approval": "0.1.7-alpha.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "author": "AskTheWay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AskTheWay/dsh-jev-interceptor.git"
  },
  "bugs": {
    "url": "https://github.com/AskTheWay/dsh-jev-interceptor/issues"
  },
  "homepage": "https://github.com/AskTheWay/dsh-jev-interceptor#readme"
}
